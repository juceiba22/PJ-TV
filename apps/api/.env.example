PORT=3001

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key — NUNCA exponer al cliente, solo se usa para el webhook de Mux
SUPABASE_SERVICE_ROLE_KEY=

# Mux (Settings > Access Tokens)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Se genera al crear el webhook endpoint en el dashboard de Mux
MUX_WEBHOOK_SECRET=
# true en desarrollo: streams de prueba (watermarked, no consumen cuota real de Mux)
MUX_TEST_STREAMS=true

# Origen permitido para CORS
WEB_APP_ORIGIN=http://localhost:3000
